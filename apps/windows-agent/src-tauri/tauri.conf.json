{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay Agent",
  "version": "0.3.5",
  "identifier": "com.joaocamargo.relay.agent",
  "build": {
    "beforeDevCommand": "pnpm --filter @relay/mac dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @relay/mac build",
    "frontendDist": "../../mac/dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Relay",
        "width": 360,
        "height": 420,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": true
      },
      {
        "label": "main",
        "title": "Relay",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/relay-service"
    ],
    "resources": {
      "vbcable/": "vbcable/"
    },
    "windows": {
      "certificateThumbprint": null,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jpecamargo/relay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFOEY2QzdBRkRERjdFQ0EKUldUS2Z0LzllbXlQYmtvNVJiM21uRlp0N0xZSDJkRUsrOHhxdXZVeDV5UjBwdGo3SUxiZDRlL3EK"
    }
  }
}
