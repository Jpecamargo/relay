{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.3.3",
  "identifier": "com.joaocamargo.relay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "Relay",
        "width": 360,
        "height": 420,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "menu"
          ],
          "state": "active",
          "radius": 12
        }
      },
      {
        "label": "main",
        "title": "Relay",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 520,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jpecamargo/relay/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFOEY2QzdBRkRERjdFQ0EKUldUS2Z0LzllbXlQYmtvNVJiM21uRlp0N0xZSDJkRUsrOHhxdXZVeDV5UjBwdGo3SUxiZDRlL3EK"
    }
  }
}
