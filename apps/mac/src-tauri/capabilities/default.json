{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões das janelas do app",
  "windows": [
    "panel",
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "positioner:default",
    "updater:default",
    "process:allow-restart"
  ]
}
