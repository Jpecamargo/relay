#!/usr/bin/env bash
# Substituto do llvm-rc só para `cargo check` cruzado no Mac: o tauri-build exige um compilador de
# recursos, mas check não linka. Cria o .res vazio pedido em /FO. NÃO usar para build real.
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    /FO|-FO) out="$2"; shift 2 ;;
    /FO*) out="${1#/FO}"; shift ;;
    *) shift ;;
  esac
done
[ -n "$out" ] && : > "$out"
exit 0
